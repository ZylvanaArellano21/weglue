{
  "expo": {
    "name": "We Glue",
    "slug": "weglue",
    "version": "1.0.4",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/e9ee8bc0-92ad-4802-8ce0-35735bb8ad47"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weglue.app",
      "associatedDomains": [
        "applinks:weglue.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.weglue.app",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weglue.app",
              "pathPrefix": "/event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weglue.app",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weglue.app",
              "pathPrefix": "/auth/confirm"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weglue.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "weglue",
              "host": "invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "weglue",
              "host": "auth",
              "pathPrefix": "/confirm-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "weglue",
              "host": "auth",
              "pathPrefix": "/confirmed"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "weglue",
              "host": "onboarding",
              "pathPrefix": "/profile-pic"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FEFCF0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We Glue needs access to your photo library to share photos and videos in chats, posts, events, and your profile.",
          "cameraPermission": "We Glue needs access to your camera to take photos to share in chats, posts, events, and your profile."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "We Glue uses your camera to take photos for your profile, posts, events, clubs, and chats.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "We Glue needs access to your photo library to save photos and videos from your chats.",
          "savePhotosPermission": "We Glue needs permission to save photos and videos from your chats.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0FA6A6",
          "defaultChannel": "clubs"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "./plugins/withPlayInstallReferrer"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "weglue",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9ee8bc0-92ad-4802-8ce0-35735bb8ad47"
      }
    }
  }
}
