# ============================================================
# We Glue — web app environment variables
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real secrets.
# Production values must ALSO be set in the Vercel dashboard
# (Settings → Environment Variables), since weglue.app reads
# Vercel's env, not your local .env.local.
# ============================================================

# Supabase project (live project ref: yoozrnosmqtaiksgcixc)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Server-only Supabase key. Must be a SINGLE valid JWT
# (header.payload.signature). Do NOT paste it twice — a duplicated
# key is silently invalid and every server call returns
# "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Server-only. The dedicated Supabase Secret API key for the store-version
# sync Edge Function — the SAME key pg_cron holds in Vault
# (store_version_sync_api_key) and the function holds as STORE_SYNC_API_KEY.
# The Admin Dashboard's "Check now" action sends it in the `apikey` header.
# Never prefix with NEXT_PUBLIC_. Without it, "Check now" reports
# "Store sync is not configured" (the 45-min cron still runs).
STORE_SYNC_API_KEY=<supabase-secret-api-key>

# Public site URL (used for redirects / links)
NEXT_PUBLIC_SITE_URL=https://weglue.app

# ------------------------------------------------------------
# TEMPORARY (Expo Go testing only) — deep link for the
# "Go back to We Glue" button on /auth/confirm.
#
# In Expo Go the production "weglue://" scheme does NOT work;
# deep links must use the exp:// form. This var holds the full
# prefix up to the in-app route; the confirm page appends the
# session tokens as a #fragment. The "/--/" segment is how
# Expo Go separates the dev-server (tunnel) address from the
# in-app deep link path.
#
#   exp://<tunnel-id>.exp.direct/--/auth/confirmed
#
# IMPORTANT: the tunnel id changes every time you restart
# `expo start --tunnel`. When it changes, update this value in
# BOTH .env.local AND the Vercel dashboard, then redeploy.
#
# Before App Store submission: REMOVE this var (here and in
# Vercel) so the page falls back to weglue://auth/confirmed.
NEXT_PUBLIC_EXPO_DEEP_LINK=exp://<tunnel-id>.exp.direct/--/auth/confirmed

# ── Admin Dashboard — secure gate (server-only) ─────────────────────────────
# Authorization is by IMMUTABLE Supabase Auth user id. Email ALONE never grants
# access; ADMIN_FOUNDER_EMAILS is only an optional consistency check. Fails
# closed when ADMIN_FOUNDER_USER_IDS is empty. Never list appreview@weglue.app
# or any tester/reviewer account.
ADMIN_FOUNDER_USER_IDS=
ADMIN_FOUNDER_EMAILS=

# Portal kill switch — the ENTIRE /admin portal (pages, APIs, actions, search,
# service-role client) is offline unless this is exactly "true".
ADMIN_PORTAL_ENABLED=false

# Write kill switch — all privileged admin mutations fail closed unless this is
# exactly "true". Keep FALSE in any production-connected environment during
# development so the dashboard stays safely read-only.
ADMIN_WRITES_ENABLED=false

# ── Admin Dashboard — private entry gateway (server-only) ───────────────────
# A pre-authentication CONCEALMENT layer, not authorization. Without a valid
# entry ticket every /admin page and /admin/api/* endpoint returns an ordinary
# 404. Passing it grants nothing: the portal switch, validated Supabase session,
# immutable founder UUID, founder email check, aal2 TOTP and the write switch all
# still apply, unchanged.
#
# FAIL-CLOSED: if any of the three required values below is missing or invalid,
# the gateway refuses every submission AND /admin stays 404 — the dashboard
# becomes unreachable rather than open.
#
# Generate the hash + cookie secret WITHOUT the phrase ever touching this repo,
# a log, or a chat transcript:
#     node apps/web/scripts/generate-admin-entry-secrets.mjs
#
# See docs/admin/admin-entry-gateway.md. Never prefix any of these with
# NEXT_PUBLIC_, and never commit real values.

# The private external path. Choose a long, unguessable value beginning with "/".
# Rejected if it sits under /_next, /api, /admin, /auth or /wgx-.
ADMIN_ENTRY_PATH=

# Salted scrypt digest of the access phrase — format:
#     scrypt$<N>$<r>$<p>$<saltBase64>$<hashBase64>
# The plaintext phrase is NEVER stored, logged, or put in a cookie or URL.
ADMIN_ENTRY_SECRET_HASH=

# HMAC key protecting the entry ticket cookie against modification.
# Must be at least 32 characters or it is treated as unconfigured.
ADMIN_ENTRY_COOKIE_SECRET=

# Ticket lifetime in minutes. Default 10, clamped to 1–60.
ADMIN_ENTRY_COOKIE_TTL_MINUTES=10
