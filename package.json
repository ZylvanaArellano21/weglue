{
  "name": "weglue",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@weglue/web",
    "dev:mobile": "turbo run dev --filter=@weglue/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "ota:production": "bash scripts/release/ota-production.sh",
    "ota:production:dry-run": "bash scripts/release/ota-production.sh --dry-run",
    "test:release": "node --test scripts/release/"
  },
  "devDependencies": {
    "image-size": "^2.0.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
