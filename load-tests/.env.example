# Staging only. The loader hard-refuses the production project and accepts only
# the allowlisted We Glue staging ref. Never commit real values.
LOADTEST_SUPABASE_URL=https://cwwmuxxqxovhcnnardlj.supabase.co
LOADTEST_STAGING_REF=cwwmuxxqxovhcnnardlj
LOADTEST_SUPABASE_ANON_KEY=
# Privileged: used only by seed/reset/cleanup and the observer (Metrics API).
LOADTEST_SUPABASE_SERVICE_ROLE_KEY=
# Privileged: must contain the staging ref. Used by preflight/seed/reset and the observer.
LOADTEST_DATABASE_URL=

# Must identify a pre-created active staging university whose name begins "Load Test ".
LOADTEST_UNIVERSITY_ID=
LOADTEST_EMAIL_DOMAIN=loadtest.invalid
LOADTEST_NAMESPACE=wg-loadtest-pre149-baseline
LOADTEST_SEED=1481492026
LOADTEST_SYNTHETIC_USERS=250

# 148 for the baseline, 149 for the comparison. Nothing else changes between them.
LOADTEST_EXPECTED_STATE=148
# Scenario: steady | cold-connect | reconnect. Cold-connect rate: 1 | 3 | 5 | 10 users/second.
LOADTEST_SCENARIO=steady
LOADTEST_COLD_CONNECT_RATE=1
# cold | warm, and a unique label per replicate (r1, r2, ...).
LOADTEST_CACHE_MODE=warm
LOADTEST_RUN_LABEL=r1

# Verified from the staging project's plan/settings before any run.
LOADTEST_VERIFIED_REALTIME_LIMIT=
LOADTEST_VERIFIED_JOINS_PER_SECOND_LIMIT=
# Auth rate_limit_token_refresh (refreshes per IP per 5 minutes).
LOADTEST_VERIFIED_TOKEN_REFRESH_LIMIT=
LOADTEST_REQUESTED_USERS=150
# Provisioned disk IOPS of the staging compute (enables the IOPS hard stop).
LOADTEST_DISK_IOPS_LIMIT=
# Operator-declared Edge Function inventory, e.g. "none" or "send-push@15".
LOADTEST_EDGE_FUNCTION_INVENTORY=none

LOADTEST_IDLE_BASELINE_SECONDS=900
# Keep password sign-ins under the staging per-IP Auth limit.
LOADTEST_AUTH_SIGNIN_INTERVAL_MS=10000
LOADTEST_RESULTS_DIR=load-tests/results

# Add only immediately before the corresponding approved operation.
# LOADTEST_CONFIRM_WRITES=I_ACKNOWLEDGE_SYNTHETIC_STAGING_WRITES_ONLY
# LOADTEST_CONFIRM_CAMPAIGN=I_HAVE_SEPARATE_APPROVAL_TO_RUN_THE_STAGING_CAMPAIGN
